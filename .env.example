# Copy to .env and edit. NEVER commit .env.
# "local" (no credentials needed) or "gcs"
STORAGE_BACKEND=local
# Required when STORAGE_BACKEND=gcs
GCS_BUCKET=your-bucket-name
# Required for gcs mode: your Google Cloud project ID
GOOGLE_CLOUD_PROJECT=your-project-id
DAYS_BACK=30
MIN_MAGNITUDE=2.5
# Optional: enables the Gemini-powered insight_agent (free key at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
